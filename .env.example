# ===========================
# BOT CONFIGURATION
# ===========================
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id_here


# ===========================
# LAVALINK (add these NEW lines)
# ===========================
LAVALINK_HOST=lava-v3.ajieblogs.eu.org
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://dsc.gg/ajidevserver
LAVALINK_SECURE=true
LAVALINK_NAME=Main

# BACKUP NODE (if first one is down)
LAVALINK_HOST2=lava.horizxon.tech
LAVALINK_PORT2=80
LAVALINK_PASSWORD2=horizxon.tech
LAVALINK_SECURE2=false
LAVALINK_NAME2=Backup


# ===========================
# DATABASE
# ===========================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/discordbot

# ===========================
# OWNER
# ===========================
OWNER_ID=your_discord_user_id
OWNER_IDS=id1,id2,id3

# ===========================
# BOT SETTINGS
# ===========================
DEFAULT_PREFIX=!
EMBED_COLOR=#2B2D31
SUCCESS_COLOR=#57F287
ERROR_COLOR=#ED4245
WARNING_COLOR=#FEE75C

# ===========================
# API KEYS (Optional)
# ===========================
WEATHER_API_KEY=your_openweathermap_key
YOUTUBE_API_KEY=your_youtube_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ===========================
# DASHBOARD (Optional)
# ===========================
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# ===========================
# LOGGING
# ===========================
ERROR_LOG_CHANNEL=channel_id_for_error_logs
BOT_LOG_CHANNEL=channel_id_for_bot_logs